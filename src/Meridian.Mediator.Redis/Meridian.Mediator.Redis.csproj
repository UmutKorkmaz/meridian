<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- XML reference docs ship beside each runtime assembly (Directory.Build.targets runs after the SDK computes DocumentationFile). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Meridian.Mediator.Redis</PackageId>
    <Version>2.1.3</Version>
    <Description>Owned leased Redis idempotency with retained uncertain outcomes and explicit application reconciliation.</Description>
    <PackageTags>mediator;redis;idempotency;cqrs</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.7.27" />
    <ProjectReference Include="../Meridian.Mediator.Caching/Meridian.Mediator.Caching.csproj" />
    <ProjectReference Include="../Meridian.Mediator/Meridian.Mediator.csproj" />
  </ItemGroup>
</Project>
