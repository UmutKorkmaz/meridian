<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- XML reference docs ship beside each runtime assembly (Directory.Build.targets runs after the SDK computes DocumentationFile). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Meridian.Mapping</RootNamespace>
    <AssemblyName>Meridian.Mapping</AssemblyName>
    <PackageId>Meridian.Mapping</PackageId>
    <Version>2.1.3</Version>
    <!-- Verified published core API baseline; new optional packages have no baseline. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.1.3</PackageValidationBaselineVersion>
    <Description>A lightweight object-to-object mapping library for .NET: runtime profiles with safe-by-default recursion and collection caps, plus opt-in source generation for selected pairs.</Description>
    <PackageTags>mapping;automapper;object-mapper;dto;transform;source-generator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <!--
    Ship the source generator as an analyzer alongside Meridian.Mapping
    so consumers get [GenerateMapper] for free without a second package
    reference. ReferenceOutputAssembly=false keeps the generator's DLL
    out of the runtime output — it's only needed at compile time.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Meridian.Mapping.Generators\Meridian.Mapping.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Explicitly pack the generator DLL under analyzers/dotnet/cs so NuGet
    installs it as an analyzer rather than a runtime reference for
    downstream consumers of the Meridian.Mapping package.
  -->
  <ItemGroup>
    <None Include="..\Meridian.Mapping.Generators\bin\$(Configuration)\netstandard2.0\Meridian.Mapping.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
