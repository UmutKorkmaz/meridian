<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiled documentation examples. Program.cs owns the canonical #region blocks that
    the guides and package READMEs show; eng/verify-docs.ps1 checks every marked fence
    against these regions, and eng/verify-packages.ps1 restores/builds/runs this project
    against the exact packed candidate on every manifest compiler host.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework Condition="'$(ConsumerFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(ConsumerFramework)' != ''">$(ConsumerFramework)</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MeridianPackageVersion Condition="'$(MeridianPackageVersion)' == ''">2.1.3</MeridianPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meridian.Mapping" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Meridian.Mediator" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>
</Project>
