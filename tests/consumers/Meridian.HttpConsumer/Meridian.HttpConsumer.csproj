<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable>
    <TargetFramework Condition="'$(ConsumerFramework)' == ''">net10.0</TargetFramework><TargetFramework Condition="'$(ConsumerFramework)' != ''">$(ConsumerFramework)</TargetFramework>
    <LangVersion>12.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MeridianPackageVersion Condition="'$(MeridianPackageVersion)' == ''">2.1.3</MeridianPackageVersion>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /><PackageReference Include="Meridian.Mediator.AspNetCore" Version="[$(MeridianPackageVersion)]" /></ItemGroup>
</Project>
