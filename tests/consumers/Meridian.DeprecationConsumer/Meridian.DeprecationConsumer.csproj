<Project Sdk="Microsoft.NET.Sdk">
  <!-- Old/new proof for docs/deprecations.md. Exactly one of OldApi.cs (legacy) or NewApi.cs (migrated) is compiled with
       Shared.cs; both must build under C# 12 with warnings as errors and no suppressions, and print the same COMMON lines. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework Condition="'$(ConsumerFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(ConsumerFramework)' != ''">$(ConsumerFramework)</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MeridianPackageVersion Condition="'$(MeridianPackageVersion)' == ''">2.1.3</MeridianPackageVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NewApi.cs" Condition="'$(MigratedConsumer)' != 'true'" />
    <Compile Remove="OldApi.cs" Condition="'$(MigratedConsumer)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Meridian.Mapping" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Meridian.Mediator" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Meridian.Mediator.Caching" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>
</Project>
