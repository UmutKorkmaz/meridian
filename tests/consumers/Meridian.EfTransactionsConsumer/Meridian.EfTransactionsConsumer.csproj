<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable>
    <TargetFramework Condition="'$(ConsumerFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(ConsumerFramework)' != ''">$(ConsumerFramework)</TargetFramework>
    <LangVersion>12.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MeridianPackageVersion Condition="'$(MeridianPackageVersion)' == ''">2.1.3</MeridianPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meridian.Mediator.EntityFrameworkCore" Version="[$(MeridianPackageVersion)]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
</Project>
