<Project>

  <!--
    Pre-csproj defaults. Runs BEFORE each csproj so values here can be
    overridden per-project. Do NOT put conditions on $(IsPackable) or
    $(PackageId) here — those aren't set yet. Use Directory.Build.targets
    for anything that needs csproj-defined properties.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Reproducible build hygiene — applies everywhere -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Sample apps demonstrate Meridian on every supported TFM. net11.0 is opt-in
    because it needs a preview SDK that contributors are not required to have:
    NETCoreSdkVersion is not populated yet at Directory.Build.props evaluation
    time, so this cannot be auto-detected here. CI sets
    MeridianIncludeNet11Samples=true (env var or -p:) after installing the .NET 11
    SDK, which keeps preview coverage without blocking local builds.
  -->
  <PropertyGroup>
    <MeridianIncludeNet11Samples Condition="'$(MeridianIncludeNet11Samples)' == ''">false</MeridianIncludeNet11Samples>
    <MeridianSampleTargetFrameworks>net8.0;net9.0;net10.0</MeridianSampleTargetFrameworks>
    <MeridianSampleTargetFrameworks Condition="'$(MeridianIncludeNet11Samples)' == 'true'">net8.0;net9.0;net10.0;net11.0</MeridianSampleTargetFrameworks>
  </PropertyGroup>

</Project>
